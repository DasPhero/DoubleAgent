# Reproducible Linux (amd64) Wails v2 build environment for DoubleAgent
# Usage (from repo root):
#   docker build -f Dockerfile.linux-build -t doubleagent-linux-builder .
#   docker run --rm -v "${PWD}:/src" -w /src doubleagent-linux-builder
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PATH="/usr/local/go/bin:/root/go/bin:${PATH}"

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    build-essential \
    pkg-config \
    libgtk-3-dev \
    libwebkit2gtk-4.1-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Go 1.26.0 (matches go.mod)
RUN curl -fsSL https://go.dev/dl/go1.26.0.linux-amd64.tar.gz -o /tmp/go.tar.gz \
    && tar -C /usr/local -xzf /tmp/go.tar.gz \
    && rm /tmp/go.tar.gz

# Install Node.js 22 LTS
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# Install Wails v2 CLI
RUN go install github.com/wailsapp/wails/v2/cmd/wails@latest

WORKDIR /src
CMD ["bash", "-lc", "wails build -tags webkit2_41 -o DoubleAgent-linux-amd64"]
